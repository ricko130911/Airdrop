# ===== WALLET (WAJIB) =====
# Private key wallet Polymarket kamu (hex). JANGAN pernah commit file .env!
POLYMARKET_PRIVATE_KEY=0x...
# 0 = EOA/MetaMask langsung, 1 = akun email/Magic, 2 = browser wallet (Gnosis Safe), 3 = deposit wallet
SIGNATURE_TYPE=2
# Alamat proxy/deposit wallet Polymarket (opsional; otomatis diturunkan untuk tipe 1 & 2)
#FUNDER_ADDRESS=0x...

# ===== PASAR =====
ASSETS=btc,eth,sol,xrp
INTERVALS=5m,15m
# Slug tambahan (pasar biner apa pun), dipisah koma
#EXTRA_SLUGS=

# ===== STRATEGI =====
# Tembak jika ask UP + ask DOWN + fee taker <= nilai ini (0.98 = untung min 2 sen/pasang)
MAX_PAIR_COST=0.98
MAX_SHARES_PER_TRADE=200
MAX_USDC_PER_TRADE=100
MAX_USDC_PER_MARKET=300
MAX_USDC_TOTAL=1000
MIN_LEG_USDC=1
STOP_BEFORE_END_SECS=5
COOLDOWN_MS=250

# ===== RISIKO SATU KAKI (leg risk) =====
RECOVERY_MAX_PAIR_COST=1.00
RECOVERY_ATTEMPTS=3
UNWIND_MAX_LOSS_PER_SHARE=0.10

# ===== KEAMANAN =====
# true = hanya simulasi, tidak kirim order. Ganti ke false setelah yakin.
DRY_RUN=true

# Endpoint (biarkan default)
#CLOB_HOST=https://clob.polymarket.com
#WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
#GAMMA_HOST=https://gamma-api.polymarket.com
