# Salin ke .env lalu isi:  cp .env.example .env && nano .env

# Mode bot yang dijalankan (boleh lebih dari satu, pisahkan koma):
# crypto, survivor, bullseye, sports
BOT_MODES=crypto

# Dashboard web
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti_dengan_password_kuat

# true = bot menyala dalam keadaan PAUSE (tidak pasang taruhan) sampai di-resume dari dashboard
START_PAUSED=false

# Chainlink Data Streams (opsional - kalau kosong, harga BTC diambil dari Binance)
CHAINLINK_API_KEY=
CHAINLINK_USER_SECRET=
