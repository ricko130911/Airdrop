# ====== WAJIB untuk mode live ======
# Buat di Unhedged: Account -> API Keys.
# Scope yang dibutuhkan: market:read, balance:read, portfolio:read,
# order:place, order:cancel, order:read (+ bet:place, bet:read jika market PARIMUTUEL).
# JANGAN aktifkan balance:withdraw.
UNHEDGED_API_KEY=

# true = simulasi (tidak ada order sungguhan). Ubah ke false hanya setelah yakin.
DRY_RUN=true

# Aset yang diperdagangkan
ASSETS=BTC,ETH,SOL,CC

# ====== Ukuran posisi & risiko ======
# Maksimum USD per order
MAX_ORDER_USD=5
# Fraksi Kelly (0.25 = quarter-Kelly, konservatif)
KELLY_FRACTION=0.25
# Modal acuan untuk Kelly. Kosong = pakai saldo available dari API (live) / 100 (dry-run)
BANKROLL_USD=
# Berhenti trading bila rugi hari ini mencapai angka ini (USD)
MAX_DAILY_LOSS_USD=25
# Total maksimum USD yang boleh terbuka bersamaan (order + posisi)
MAX_OPEN_EXPOSURE_USD=20

# ====== Strategi ======
# Selisih minimal antara peluang model dan harga (0.05 = 5 sen per kontrak $1)
MIN_EDGE=0.05
# Jangan pernah beli di atas harga ini / di bawah harga ini
MAX_PRICE=0.92
MIN_PRICE=0.05
# Mulai trading saat sisa waktu market <= detik ini
TRADE_WHEN_SECONDS_LEFT=180
# Berhenti dan batalkan order saat sisa waktu <= detik ini
STOP_SECONDS_LEFT=15
# Pengali volatilitas (>1 = lebih hati-hati, mengantisipasi lonjakan harga)
SIGMA_MULTIPLIER=1.3
# Bobot momentum jangka pendek (0 = abaikan momentum)
MOMENTUM_WEIGHT=0.2
# Ubah harga order bila target bergeser minimal sebesar ini
REPRICE_THRESHOLD=0.03
# Keyakinan tambahan yang dibutuhkan untuk berpindah ke sisi lawan (anti bolak-balik)
HYSTERESIS=0.05
# Fee per kontrak sebagai fraksi harga. Kosong = tarif taker dari data market (tier 0 = 5%)
FEE_RATE=

# ====== Strategi ======
# sniper = tembak di detik-detik terakhir round bila hasil hampir pasti (default)
# model  = strategi lama (menebak arah lebih awal) - terbukti rugi di simulasi
STRATEGY=sniper
# Jendela tembak: dari sisa SNIPE_MAX_SEC sampai SNIPE_MIN_SEC detik sebelum tutup
SNIPE_MAX_SEC=45
SNIPE_MIN_SEC=4
# Peluang menang minimal (0.97 = 97%)
SNIPE_MIN_PROB=0.97
# Harga beli maksimum per kontrak
SNIPE_MAX_PRICE=0.95
# Untung minimal per kontrak setelah fee (0.015 = 1.5 sen)
SNIPE_MIN_EV=0.015
# Modal MINIMUM per tembakan (USD)
SNIPE_USD=3
# Modal MAKSIMUM per tembakan saat bot sangat yakin (USD)
SNIPE_MAX_USD=10
# Seberapa agresif menaikkan taruhan: fraksi saldo x Kelly (0.05 = hati-hati)
SNIPE_KELLY_FRACTION=0.05
# Taruhan baru boleh naik setelah minimal sekian trade sniper DAN akurasi yang terbukti secara
# statistik (batas bawah 95%) di atas titik impas
SNIPE_TRUST_TRADES=30
# Seberapa sering bot memeriksa harga selama jendela tembak (ms)
SNIPE_POLL_MS=1000
# Rem: berhenti menembak sampai besok setelah kalah sebanyak ini dalam sehari
SNIPE_MAX_LOSSES_PER_DAY=2
# Berhenti trading setelah untung hari ini mencapai angka ini (0 = tanpa target)
DAILY_PROFIT_TARGET_USD=0
# Model fee: flat = tarif x harga (konservatif), risk = tarif x min(harga, 1-harga)
FEE_MODEL=flat

# ====== Pembelajaran (bot belajar dari hasilnya sendiri) ======
# true = kalibrasi peluang otomatis + blokir zona waktu/aset yang terbukti rugi
ADAPTIVE=true
# Minimal trade di satu zona sebelum zona itu boleh diblokir
ADAPTIVE_MIN_TRADES=25
# Minimal market per titik waktu sebelum kalibrasi peluang diaktifkan
CALIBRATION_MIN_SAMPLES=40
# Di zona yang diblokir, tetap kirim order 1 kontrak agar bisa belajar bila kondisi membaik
PROBE_TRADES=true

# ====== Pencarian market ======
# Durasi market dalam detik (5 menit)
MARKET_DURATION_SEC=300
# Opsional: regex khusus untuk mencocokkan judul/slug market (kosongkan untuk otomatis)
MARKET_REGEX=
# Kategori feed (kosongkan bila tidak yakin)
FEED_CATEGORY=

# ====== Teknis ======
POLL_MS=4000
DISCOVERY_MS=30000
LOG_LEVEL=info
API_BASE_URL=https://api.unhedged.gg

# ====== Dashboard web ======
DASHBOARD_ENABLED=true
# 0.0.0.0 = bisa diakses dari luar lewat http://IP_VPS:3005
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3005
# true = halaman utama http://IP:3005 bisa dibuka TANPA login (cocok untuk Smart TV).
# Tampilan ini hanya untuk melihat: tombol kontrol disembunyikan & nama akun tidak ditampilkan.
DASHBOARD_PUBLIC_VIEW=true
# Login untuk halaman kontrol http://IP:3005/admin (jeda trading, batalkan order).
# Kosongkan password = halaman /admin dimatikan (kontrol lewat pm2/SSH saja).
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
